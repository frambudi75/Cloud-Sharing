APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:2021
WEB_PORT=2021

# ==============================================================================
# Database Configuration
# ==============================================================================
# Untuk Docker (Server Linux / Production):
# - DB_HOST harus bernilai 'db'
# - Jika mengubah DB_PASSWORD pada database yang sudah ada, reset volume data dengan:
#   docker compose down -v && docker compose up -d
#
# Untuk XAMPP (Windows Localhost):
# - DB_HOST=127.0.0.1
# - DB_USERNAME=root
# - DB_PASSWORD=
# ==============================================================================
DB_HOST=db
DB_PORT=3306
DB_DATABASE=filesharing_db
DB_USERNAME=fileshare_user
DB_PASSWORD=fileshare_secret
DB_ROOT_PASSWORD=rootsecret
DB_EXTERNAL_PORT=3307

# Storage Configuration
STORAGE_PATH=/var/www/storage/uploads
MAX_UPLOAD_SIZE_MB=1024
DEFAULT_USER_QUOTA_MB=5120
